{
  "name": "codex-accounts-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run check:style && bun build public/app.js --target=browser --outdir /tmp/codex-accounts-proxy-check",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "check:style": "biome check .",
    "check:staged": "bun tools/check-staged.ts",
    "hooks:install": "bun tools/setup-hooks.ts",
    "prepare": "bun tools/setup-hooks.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7"
  }
}
